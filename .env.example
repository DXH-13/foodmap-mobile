# Copy thành .env rồi điền giá trị thật. KHÔNG commit file .env.
#
# ⚠️ Biến có tiền tố EXPO_PUBLIC_ được NHÚNG VÀO BUNDLE và ai cũng đọc được.
#    Không bao giờ đặt secret ở đây.

# ⚠️ Phải là IP LAN của máy chạy backend — KHÔNG dùng localhost.
#    Thiết bị thật và máy ảo Android hiểu "localhost" là chính chúng.
#    Tìm IP: ipconfig (Windows) · ifconfig | grep inet (macOS)
#    Emulator Android có thể dùng http://10.0.2.2:8080
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8080

# Khoá Google Maps dành cho client.
# BẮT BUỘC giới hạn trong Google Cloud Console theo bundle id / package name
# (vn.foodmap.app) và theo API — khoá không giới hạn bị lấy dùng sẽ khiến bạn
# trả tiền cho lưu lượng của người khác.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
